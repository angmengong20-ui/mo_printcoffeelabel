/*
  Permissions-Policy: bluetooth=(self)
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; img-src 'self' blob: data:; connect-src 'self'; media-src 'self' blob:; base-uri 'none'; form-action 'none'

/index.html
  Cache-Control: no-cache
  Permissions-Policy: bluetooth=(self)
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; img-src 'self' blob: data:; connect-src 'self'; media-src 'self' blob:; base-uri 'none'; form-action 'none'

/*.js
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
